# Copia este archivo como .env y rellena los valores.
# Necesitas al menos UNA API key de un proveedor de IA (o el
# modelo local) para que la app funcione.

# ── Base de datos (OBLIGATORIO) ──────────────────────────
# Cadena de conexión de Neon (Postgres + pgvector). Sustituye a
# la antigua carpeta games/ como fuente de verdad en producción
# — ver docs/CONFIGURATION.md para cómo crear el proyecto y
# aplicar db/schema.sql.
DATABASE_URL=

# ── Almacenamiento de archivos (OBLIGATORIO) ─────────────
# Backblaze B2 (bucket PRIVADO — nunca lo pongas en público, el
# backend es el único que debe tener acceso). Compatible con la
# API de S3.
B2_ENDPOINT=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=

# ── Autenticación (OBLIGATORIO) ──────────────────────────
# Secreto usado para firmar los tokens de sesión (JWT) — mínimo
# 32 caracteres. Genera uno seguro con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA compartas este valor ni lo subas a git — cualquiera que
# lo tenga podría fabricar tokens de sesión válidos para
# cualquier usuario.
JWT_SECRET=
# Cuánto dura la sesión antes de tener que volver a iniciar
# sesión. Acepta formatos de la librería "ms" (30d, 12h, etc.).
JWT_EXPIRES_IN=30d
# Máximo de intentos de login/registro por IP cada 15 minutos.
AUTH_RATE_LIMIT=10

# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL pública de este servicio (para las portadas de los juegos).
# En Render normalmente no hace falta: se autodetecta con
# RENDER_EXTERNAL_URL. Solo la necesitas si no despliegas en Render
# o quieres forzar un valor concreto.
API_PUBLIC_URL=

# Orígenes adicionales permitidos por CORS, separados por comas
# (la URL de producción ya está permitida por defecto). Útil para
# probar en local contra un frontend en localhost.
# Ejemplo: FRONTEND_URL=http://localhost:5173
FRONTEND_URL=

# Máximo de preguntas por IP cada 15 minutos, para proteger tu
# cuota de pago de un uso abusivo.
CHAT_RATE_LIMIT=20

# ── Proveedor de embeddings (OBLIGATORIO) ───────────────────
# Debe ser SIEMPRE el mismo valor en tu máquina local y en el
# servidor desplegado — mezclar proveedores distintos para
# embeddings rompe la búsqueda por similitud. Ver README.
# Valores válidos: local | gemini | mistral | openai | deepinfra | together
AI_EMBEDDING_PROVIDER=gemini

# ── Orden de proveedores para CHAT (con fallback automático) ─
# Aquí SÍ es seguro poner varios — si uno falla por cuota, se
# prueba el siguiente. No afecta a los embeddings.
AI_PROVIDER_ORDER=gemini,openrouter,openai,mistral,deepinfra,together

# ── Gemini (Google AI Studio) ────────────────────────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_VERSION=v1beta

# ── OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemma-3-27b-it

# ── Mistral ───────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── DeepInfra ─────────────────────────────────────────────
DEEPINFRA_API_KEY=
DEEPINFRA_CHAT_MODEL=
DEEPINFRA_EMBEDDING_MODEL=

# ── Together AI ───────────────────────────────────────────
TOGETHER_API_KEY=
TOGETHER_CHAT_MODEL=
TOGETHER_EMBEDDING_MODEL=

# ── Modelo de embeddings local (opcional) ────────────────
# Gratis e ilimitado, corre en tu propia máquina. Requiere
# `npm install` con acceso normal a internet. Ver README para
# más detalles y limitaciones en plataformas gratuitas de hosting.
LOCAL_EMBEDDING_ENABLED=false
LOCAL_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# ── Ajustes de importación de juegos (npm run import) ────
# Cuántos chunks se agrupan en una sola petición de embeddings.
IMPORT_EMBEDDING_BATCH_SIZE=40
# Cuántos lotes en paralelo.
IMPORT_EMBEDDING_CONCURRENCY=1
# Espera (ms) antes de cada petición.
IMPORT_EMBEDDING_REQUEST_DELAY=500
